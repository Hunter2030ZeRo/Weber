+//! Two separate contexts connected only by bounded JSON messages.
+//! Dispatcher functions are rooted privately in Rust, never on page globals.
+use deno_core::v8;
+use serde_json::{json, Value};
+use super::{exception_text, ObscuraJsRuntime};
+
+pub(super) struct DesktopBridge {
+    isolated: v8::Global<v8::Context>,
+    main_dispatch: v8::Global<v8::Function>,
+    isolated_dispatch: v8::Global<v8::Function>,
+}
+
+impl ObscuraJsRuntime {
+    fn compile_desktop_dispatcher(
+        &mut self,
+        context: &v8::Global<v8::Context>,
+        source: &str,
+    ) -> Result<v8::Global<v8::Function>, String> {
+        let mut entered = self.runtime();
+        let isolate = entered.v8_isolate();
+        let scope = &mut v8::HandleScope::new(isolate);
+        let context = v8::Local::new(scope, context);
+        let scope = &mut v8::ContextScope::new(scope, context);
+        let scope = &mut v8::TryCatch::new(scope);
+        let code = v8::String::new(scope, source).ok_or("Bridge bootstrap is too large")?;
+        let script = v8::Script::compile(scope, code, None).ok_or_else(|| exception_text(scope))?;
+        let value = script.run(scope).ok_or_else(|| exception_text(scope))?;
+        let function = v8::Local::<v8::Function>::try_from(value)
+            .map_err(|_| "Bridge bootstrap did not return a function")?;
+        Ok(v8::Global::new(scope, function))
+    }
+
+    /// Install before author scripts. The isolated context is intentionally
+    /// bare: no DOM, Node.js, network ops, or published frame/window handles.
+    /// Supported preload APIs are supplied by the trusted bootstrap source.
+    pub fn install_desktop_bridge(
+        &mut self,
+        main_bootstrap: &str,
+        isolated_bootstrap: &str,
+        preload_source: &str,
+    ) -> Result<(), String> {
+        if self.desktop_bridge.is_some() { return Err("Desktop bridge already installed".into()); }
+        let isolated = {
+            let mut entered = self.runtime();
+            let scope = &mut v8::HandleScope::new(entered.v8_isolate());
+            let context = v8::Context::new(scope, v8::ContextOptions::default());
+            v8::Global::new(scope, context)
+        };
+        // Deno's isolate-level Promise rejection callback dereferences these
+        // slots. Reuse its existing frame-realm lifetime mechanism, without
+        // sharing any JS ops, security token, DOM objects, or global objects.
+        self.share_deno_context_state_with_realm(&isolated);
+        let main = self.runtime().main_context();
+        let token = self.arm_watchdog(std::time::Duration::from_secs(2));
+        let compiled = (|| {
+            let isolated_dispatch = self.compile_desktop_dispatcher(&isolated, isolated_bootstrap)?;
+            let main_dispatch = self.compile_desktop_dispatcher(&main, main_bootstrap)?;
+            self.desktop_bridge = Some(DesktopBridge { isolated, main_dispatch, isolated_dispatch });
+            Ok::<_, String>(())
+        })();
+        let timed_out = self.disarm_watchdog(token);
+        if timed_out { self.desktop_bridge = None; return Err("Bridge bootstrap timed out".into()); }
+        compiled?;
+        let configured = self.desktop_bridge_command(true, &json!({
+            "method": "configure", "source": preload_source,
+        }))?;
+        if configured.get("ok").and_then(Value::as_bool) != Some(true) {
+            self.desktop_bridge = None;
+            return Err(configured.get("error").and_then(Value::as_str)
+                .unwrap_or("Isolated preload failed").to_string());
+        }
+        let installed = self.desktop_bridge_command(false, &json!({
+            "method": "install", "exports": configured["value"],
+        }))?;
+        if installed.get("ok").and_then(Value::as_bool) != Some(true) {
+            self.desktop_bridge = None;
+            return Err(installed.get("error").and_then(Value::as_str)
+                .unwrap_or("Context bridge installation failed").to_string());
+        }
+        Ok(())
+    }
+
+    /// Calls a privately rooted dispatcher with serialized data. No function,
+    /// Promise, Error, prototype, or other JS reference crosses contexts.
+    pub fn desktop_bridge_command(&mut self, isolated: bool, request: &Value) -> Result<Value, String> {
+        let text = request.to_string();
+        if text.len() > 1024 * 1024 { return Err("Bridge request exceeds 1 MiB".into()); }
+        let (context, dispatcher) = {
+            let bridge = self.desktop_bridge.as_ref().ok_or("Desktop bridge unavailable")?;
+            if isolated {
+                (bridge.isolated.clone(), bridge.isolated_dispatch.clone())
+            } else {
+                let dispatcher = bridge.main_dispatch.clone();
+                (self.runtime().main_context(), dispatcher)
+            }
+        };
+        let token = self.arm_watchdog(std::time::Duration::from_secs(2));
+        let result = (|| {
+            let mut entered = self.runtime();
+            let reply = {
+                let scope = &mut v8::HandleScope::new(entered.v8_isolate());
+                let context = v8::Local::new(scope, &context);
+                let scope = &mut v8::ContextScope::new(scope, context);
+                let scope = &mut v8::TryCatch::new(scope);
+                let function = v8::Local::new(scope, &dispatcher);
+                let argument = v8::String::new(scope, &text).ok_or("Bridge argument allocation failed")?;
+                let receiver = v8::undefined(scope).into();
+                let result = function.call(scope, receiver, &[argument.into()])
+                    .ok_or_else(|| exception_text(scope))?;
+                if !result.is_string() { return Err("Invalid bridge reply".into()); }
+                let reply = result.to_rust_string_lossy(scope);
+                if reply.len() > 2 * 1024 * 1024 { return Err("Bridge reply exceeds 2 MiB".into()); }
+                reply
+            };
+            // Bare-realm promises share the isolate microtask queue. Advance
+            // completed IPC/bridge callbacks without waiting on external I/O.
+            entered.v8_isolate().perform_microtask_checkpoint();
+            serde_json::from_str(&reply).map_err(|error| format!("Invalid bridge JSON: {error}"))
+        })();
+        if self.disarm_watchdog(token) {
+            self.desktop_bridge = None;
+            return Err("Bridge execution timed out; renderer restart required".into());
+        }
+        result
+    }
+}
