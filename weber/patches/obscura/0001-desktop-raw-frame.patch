diff --git a/crates/obscura-js/src/runtime.rs b/crates/obscura-js/src/runtime.rs
--- a/crates/obscura-js/src/runtime.rs
+++ b/crates/obscura-js/src/runtime.rs
@@ -1528,3 +1528,39 @@
+    /// Return the retained viewport as premultiplied RGBA8 for a desktop surface.
+    /// Uses the same layout, resource cache, scroll state and canvas backing
+    /// surfaces as screenshot capture, without PNG compression or decoding.
+    #[cfg(feature = "render")]
+    pub fn render_frame_rgba(
+        &self,
+        viewport: (f32, f32),
+        base_url: Option<&str>,
+        surface_color: [u8; 4],
+    ) -> Option<(u32, u32, Vec<u8>)> {
+        let mut state = self.state.borrow_mut();
+        let effective_base = document_base_url(&state);
+        if viewport != state.viewport || base_url != effective_base.as_deref() {
+            return None;
+        }
+        with_sync_render_loading_disabled(&mut state, |state| {
+            ensure_resolved_scroll(state)?;
+            let ObscuraState {
+                dom, prepared_render, render_resources, resolved_scroll,
+                canvas_surfaces, ..
+            } = state;
+            let (_, scroll) = resolved_scroll.as_ref()?;
+            let canvas_surfaces = RuntimeCanvasSurfaceSource(canvas_surfaces);
+            let pixmap =
+                obscura_render::paint_prepared_with_scroll_and_surface_color_and_canvas_surfaces(
+                    dom.as_ref()?,
+                    prepared_render.as_mut()?,
+                    render_resources,
+                    scroll,
+                    surface_color,
+                    &canvas_surfaces,
+                )?;
+            Some((pixmap.width(), pixmap.height(), pixmap.take()))
+        })
+    }
