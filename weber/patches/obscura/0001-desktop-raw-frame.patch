diff --git a/crates/obscura-browser/src/page.rs b/crates/obscura-browser/src/page.rs
--- a/crates/obscura-browser/src/page.rs
+++ b/crates/obscura-browser/src/page.rs
@@ -3758,3 +3758,20 @@
+    /// Present the live viewport without an encode/decode cycle.
+    /// Pixel bytes are premultiplied RGBA8, row-major, with no row padding.
+    /// Width and height currently follow the CSS viewport (scale factor 1).
+    #[cfg(feature = "render")]
+    pub fn render_frame_rgba(&self) -> Option<(u32, u32, Vec<u8>)> {
+        let js = self.js.as_ref()?;
+        if !js.set_animation_sample(self.live_animation_sample()) {
+            return None;
+        }
+        let base_url = self.resolve_base_url();
+        js.render_frame_rgba(
+            self.viewport,
+            base_url.as_ref().map(|url| url.as_str()),
+            self.capture_surface_color(),
+        )
+    }
