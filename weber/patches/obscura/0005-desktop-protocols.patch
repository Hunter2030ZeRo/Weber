@@ -0,0 +1,29 @@
+//! Optional embedder-owned protocols. Absent for ordinary headless contexts.
+use std::collections::HashMap;
+use url::Url;
+use crate::{RequestInfo, Response, ObscuraNetError};
+
+#[async_trait::async_trait]
+pub trait DesktopProtocolHandler: Send + Sync {
+    fn accepts(&self, scheme: &str) -> bool;
+    fn standard(&self, scheme: &str) -> bool;
+    fn fetch_enabled(&self, scheme: &str) -> bool;
+    async fn request(&self, request: &RequestInfo, body: &[u8], initiator: &str)
+        -> Result<Response, ObscuraNetError>;
+}
+pub fn origin(url: &Url, handler: &dyn DesktopProtocolHandler) -> String {
+    if handler.standard(url.scheme()) && url.has_host() {
+        let port = url.port().map(|p| format!(":{p}")).unwrap_or_default();
+        format!("{}://{}{port}", url.scheme(), url.host_str().unwrap_or_default())
+    } else { url.origin().ascii_serialization() }
+}
+pub fn cors_allowed(source: &str, target: &Url, handler: &dyn DesktopProtocolHandler,
+    headers: &HashMap<String, String>, mode: &str, credentials: bool) -> bool {
+    let target_origin = origin(target, handler);
+    if source.is_empty() || (source != "null" && source == target_origin) { return true; }
+    if mode == "same-origin" { return false; }
+    if mode == "no-cors" { return true; }
+    let allow = headers.get("access-control-allow-origin").map(String::as_str).unwrap_or("");
+    (allow == source || (allow == "*" && !credentials))
+        && (!credentials || headers.get("access-control-allow-credentials").is_some_and(|value| value == "true"))
+}
