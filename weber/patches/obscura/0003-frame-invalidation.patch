+    /// Read retained rendering invalidation without layout, painting or JS.
+    /// Connected DOM changes, canvas task damage, image arrivals and scrolling
+    /// update activity_generation. Dirty retained caches cover font/resource,
+    /// viewport, base URL and media invalidation even without a DOM mutation.
+    #[cfg(feature = "render")]
+    pub fn desktop_render_damage(&self) -> (u64, u64, bool) {
+        let state = self.state.borrow();
+        let dirty = state.prepared_render.is_none()
+            || !state.pending_style_mutations.is_empty()
+            || state.resolved_scroll.is_none()
+            || state.prepared_render.as_ref()
+                .is_some_and(|prepared| prepared.has_active_css_animations());
+        (state.document_generation, state.activity_generation, dirty)
     }
 
