     /// Rasterize the current DOM to PNG bytes at `viewport` (CSS pixels), when
     /// the render feature is compiled in. None if the page has no DOM or the
     /// viewport is zero-sized.
+    /// Skip an unchanged retained frame before layout, rasterization or copying.
+    /// CSS/Web Animations continue producing frames until their active interval
+    /// ends; JavaScript timers remain owned by the normal browser event loop.
+    #[cfg(feature = "render")]
+    pub fn render_frame_rgba_if_changed(
+        &self,
+    ) -> Result<Option<(u32, u32, Vec<u8>)>, String> {
+        let js = self.js.as_ref().ok_or("No document loaded")?;
+        let (document, activity, dirty) = js.desktop_render_damage();
+        let stamp = (
+            self.document_timeline_origin, document, activity,
+            self.viewport.0.to_bits(), self.viewport.1.to_bits(),
+            self.capture_surface_color(),
+        );
+        if self.desktop_frame_stamp.get() == Some(stamp) && !dirty {
+            return Ok(None);
+        }
+        let frame = self.render_frame_rgba().ok_or("Rendering failed")?;
+        // A successful paint may clamp scrolling or process retained changes.
+        // Record its final generation, never acknowledge a failed frame.
+        let (document, activity, _) = js.desktop_render_damage();
+        self.desktop_frame_stamp.set(Some((
+            self.document_timeline_origin, document, activity,
+            self.viewport.0.to_bits(), self.viewport.1.to_bits(),
+            self.capture_surface_color(),
+        )));
+        Ok(Some(frame))
+    }
