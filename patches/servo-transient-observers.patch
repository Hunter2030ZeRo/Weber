+    /// Preserve subtree observations on a removed subtree until notification.
+    pub(crate) fn register_transient_observers(cx: &JSContext, node: &Node, parent: &Node) {
+        let mut found = false;
+        for ancestor in parent.inclusive_ancestors_unrooted(cx.no_gc(), ShadowIncluding::No) {
+            let Some(registered) = ancestor.registered_mutation_observers() else {
+                continue;
+            };
+            for entry in registered.iter().filter(|entry| entry.options.subtree) {
+                found = true;
+                let observer = entry.observer.as_rooted();
+                node.add_mutation_observer(RegisteredObserver {
+                    observer: Dom::from_ref(&observer),
+                    options: entry.options.clone(),
+                    source: Some(
+                        entry
+                            .source
+                            .as_ref()
+                            .cloned()
+                            .unwrap_or_else(|| Dom::from_ref(&ancestor)),
+                    ),
+                });
