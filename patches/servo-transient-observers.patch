+                    .node_list
+                    .borrow()
+                    .iter()
+                    .any(|item| &**item == node)
+                {
+                    observer.node_list.borrow_mut().push(Dom::from_ref(node));
+                }
+                ScriptThread::mutation_observers().add_mutation_observer(&observer);
+            }
+        }
+        if found {
+            ScriptThread::mutation_observers().queue_mutation_observer_microtask(cx);
+        }
+    }
+
+    pub(crate) fn clear_transient_observers(&self, source: Option<&Node>) {
+        let nodes: Vec<_> = self
+            .node_list
+            .borrow()
+            .iter()
+            .map(|node| node.as_rooted())
+            .collect();
+        for node in &nodes {
+            node.registered_mutation_observers_mut().retain(|entry| {
+                entry.observer != self
+                    || entry.source.is_none()
+                    || source.is_some_and(|source| {
+                        entry
+                            .source
+                            .as_ref()
+                            .is_some_and(|entry| &**entry != source)
+                    })
+            });
+        }
+        self.node_list.borrow_mut().retain(|node| {
+            node.registered_mutation_observers()
+                .is_some_and(|entries| entries.iter().any(|entry| entry.observer == self))
+        });
+    }
