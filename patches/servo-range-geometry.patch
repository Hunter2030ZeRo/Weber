+#[expect(
+    unsafe_code,
+    reason = "DOM ancestor walk stays within the current layout state"
+)]
+pub(crate) fn process_text_range_rects_request(
+    node: ServoLayoutNode<'_>,
+    scroll_tree: &ScrollTree,
+    range: std::ops::Range<Utf32CodeUnits>,
+) -> CSSPixelRectVec {
+    fn collect(
+        fragment: &Fragment,
+        target: OpaqueNode,
+        scroll_tree: &ScrollTree,
+        range: &std::ops::Range<Utf32CodeUnits>,
+        found: &mut bool,
+        rects: &mut CSSPixelRectVec,
+    ) {
+        if let Fragment::Text(text) = fragment {
+            if text.base.tag.is_none_or(|tag| tag.node != target) {
+                return;
+            }
+            *found = true;
+            if let Some((origin, spatial_node)) = *text.spatial.borrow() {
+                if let Some(rect) = text.range_rect(range.clone()) {
+                    let transform = scroll_tree.cumulative_node_to_root_transform(spatial_node);
+                    if let Some(rect) =
+                        transform_au_rectangle(rect.translate(origin.to_vector()), transform)
+                    {
+                        rects.push(rect);
+                    }
+                }
+            }
+        } else if let Some(children) = fragment.children() {
+            for child in children.iter() {
+                collect(child, target, scroll_tree, range, found, rects);
+            }
+        }
+    }
+    // TextRun has no LayoutBoxBase fragment list. Find its actual shaped
+    // fragments under the nearest rendered ancestor without building a mirror
+    // or retaining another per-node fragment index.
+    let target = node.opaque();
+    let mut ancestor = Some(node);
+    while let Some(node) = ancestor {
+        let mut rects = Vec::new();
+        let mut found = false;
+        for fragment in &node.fragments_for_pseudo(None) {
+            collect(
+                fragment,
+                target,
+                scroll_tree,
+                &range,
+                &mut found,
+                &mut rects,
+            );
+        }
+        if found {
+            return rects;
+        }
+        ancestor = unsafe { node.dangerous_dom_parent() };
+    }
+    Vec::new()
 }
 
