 impl TextFragment {
+    /// Selected advance bounds in this shaped fragment. Offsets are DOM Unicode
+    /// scalar offsets; white-space/text-transform mapping is owned by run_data.
+    pub(crate) fn range_rect(&self, dom_range: Range<Utf32CodeUnits>) -> Option<PhysicalRect<Au>> {
+        let range = self
+            .run_data
+            .map_dom_range_to_transformed_range(dom_range.into());
+        let fragment_range = &self.character_range_in_dom_node;
+        if range.start > fragment_range.end
+            || range.end < fragment_range.start
+            || (!range.is_empty()
+                && (range.end == fragment_range.start || range.start == fragment_range.end))
+        {
+            return None;
+        }
+        let mut character = if self.is_rtl {
+            fragment_range.end
+        } else {
+            fragment_range.start
+        };
+        let mut advance = Au::zero();
+        let mut selected: Option<(Au, Au)> = None;
+        for store in &self.glyphs {
+            for glyph in store.glyphs() {
+                let count = glyph.character_count();
+                let next_character = if self.is_rtl {
+                    character - count
+                } else {
+                    character + count
+                };
+                let low = character.min(next_character);
+                let high = character.max(next_character);
+                let next_advance = advance
+                    + glyph.advance()
+                    + if glyph.char_is_word_separator() {
+                        self.justification_adjustment
+                    } else {
+                        Au::zero()
+                    };
+                let bounds =
+                    if range.is_empty() && range.start >= low && range.start <= high && count.0 > 0
+                    {
+                        if range.start == character {
+                            Some((advance, advance))
+                        } else if range.start == next_character {
+                            Some((next_advance, next_advance))
+                        } else {
+                            Some((advance, next_advance))
+                        }
+                    } else if range.start < high && range.end > low {
+                        Some((advance, next_advance))
+                    } else {
+                        None
+                    };
+                if let Some((start, end)) = bounds {
+                    selected =
+                        Some(selected.map_or((start, end), |(a, b)| (a.min(start), b.max(end))));
+                }
+                character = next_character;
+                advance = next_advance;
+            }
+        }
+        let (start, end) = selected.or_else(|| {
+            (range.is_empty() && self.glyphs.is_empty()).then_some((Au::zero(), Au::zero()))
+        })?;
+        let mut rect = self.base.rect();
+        if self.style().writing_mode.is_vertical() {
+            rect.origin.y += start;
+            rect.size.height = end - start;
+            rect.size.width = self.font_metrics.ascent + self.font_metrics.descent;
+        } else {
+            rect.origin.x += start;
+            rect.size.width = end - start;
+            rect.size.height = self.font_metrics.ascent + self.font_metrics.descent;
+        }
+        Some(rect)
+    }
