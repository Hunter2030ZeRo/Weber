 }
+
+/// Bounded DOM-size heuristic, including the shadow trees used by native controls.
+fn weber_small_document(root: script::layout_dom::ServoDangerousStyleNode<'_>) -> bool {
+    static LIMIT: LazyLock<usize> = LazyLock::new(|| {
+        std::env::var("WEBER_SERIAL_DOM_LIMIT")
+            .ok()
+            .and_then(|value| value.parse().ok())
+            .filter(|limit| *limit <= 4096)
+            .unwrap_or(256)
+    });
+    if *LIMIT == 0 { return false; }
+    let mut visited = 0;
+    let mut pending = vec![root];
+    while let Some(current) = pending.pop() {
+        visited += 1;
+        if visited > *LIMIT { return false; }
+        if let Some(sibling) = current.next_sibling() { pending.push(sibling); }
+        if let Some(child) = current.first_child() { pending.push(child); }
+        if let Some(shadow) = current.as_element().and_then(|element| element.shadow_root()) {
+            pending.push(shadow.as_node());
+        }
+    }
+    log::trace!("Weber document node count including shadow trees: {visited}");
+    true
+}
