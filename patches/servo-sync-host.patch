+/// Weber's bounded exchange while the originating script call is suspended.
+#[derive(Deserialize, Serialize)]
+pub enum WeberHostReply {
+    Final(Option<String>),
+    Query(String, GenericSender<Option<String>>),
+}
+
+/// A scoped route to the originating script realm, not the Servo event loop.
+#[derive(Clone)]
+pub struct WeberDomQuery(pub GenericSender<WeberHostReply>);
+
+impl WeberDomQuery {
+    pub fn query(&self, payload: String) -> Option<String> {
+        if payload.len() > 1_048_576 { return None; }
+        let (sender, receiver) = servo_base::generic_channel::channel()?;
+        self.0.send(WeberHostReply::Query(payload, sender)).ok()?;
+        receiver.try_recv_timeout(std::time::Duration::from_secs(30)).ok().flatten()
+    }
+}
