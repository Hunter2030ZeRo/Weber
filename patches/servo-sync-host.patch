+    fn WeberHostCall(&self, cx: &mut JSContext, payload: DOMString, query: Option<RootedCallback<WeberDOMQuery>>) -> Option<DOMString> {
+        let payload = String::from(payload);
+        if payload.len() > 1_048_576 {
+            return None;
+        }
+        let (sender, receiver) =
+            ProfiledGenericChannel::channel(self.global().time_profiler_chan().clone())?;
+        self.send_to_embedder(EmbedderMsg::WeberHostCall(
+            self.webview_id(), payload, sender,
+        ));
+        let receiver = receiver.into_inner();
+        // Only service explicit queries for this call. Do not spin a nested
+        // script event loop or call the embedder recursively.
+        loop {
+            match receiver.try_recv_timeout(std::time::Duration::from_secs(30)).ok()? {
+                WeberHostReply::Final(reply) => return reply.map(Into::into),
+                WeberHostReply::Query(payload, sender) => {
+                    let result = if payload.len() > 1_048_576 { None } else {
+                        query.as_ref().and_then(|callback| {
+                            callback.Call__(cx, DOMString::from(payload), ExceptionHandling::Report).ok().flatten().map(String::from)
+                        })
+                    };
+                    if sender.send(result).is_err() { return None; }
+                },
+            }
+        }
+    }
