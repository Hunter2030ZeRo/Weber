+
+//! Native plain-text editing uses the live DOM and Servo's editing commands.
+//! Position maps below are temporary; no parallel DOM or JS editor is retained.
+use crate::dom::characterdata::CharacterData;
+use crate::dom::htmlelement::HTMLElement;
+use crate::dom::range::Range;
+use crate::dom::selection::Selection;
+use crate::dom::text::Text;
+use crate::dom::types::{Event, InputEvent};
+use crate::dom::{Document, Element, Node};
+use embedder_traits::{EditingDirection, EditingMotion, ImeSurroundingText, ModifySelection};
+use js::context::JSContext;
+use script_bindings::cell::DomRefCell;
+use script_bindings::codegen::GenericBindings::CharacterDataBinding::CharacterDataMethods;
+use script_bindings::codegen::GenericBindings::DocumentBinding::DocumentMethods;
+use script_bindings::codegen::GenericBindings::NodeBinding::NodeMethods;
+use script_bindings::codegen::GenericBindings::RangeBinding::RangeMethods;
+use script_bindings::codegen::GenericBindings::SelectionBinding::SelectionMethods;
+use script_bindings::dom::MutNullableDom;
+use script_bindings::inheritance::Castable;
+use script_bindings::root::{Dom, DomRoot};
+use script_bindings::str::DOMString;
+use servo_base::text::Utf16CodeUnits;
+use servo_base::{Rope, RopeMovement};
+use web_atoms::local_name;
+
+#[derive(Default, JSTraceable, MallocSizeOf)]
+pub(crate) struct NativeEditing {
+    pub composition_host: MutNullableDom<HTMLElement>,
+    pub composition_range: MutNullableDom<Range>,
+    history: DomRefCell<EditHistory>,
+}
+
+// Retain original nodes, never innerHTML/clones: restoring an edit preserves
+// event listeners, framework references and custom-element identity.
+#[derive(Clone, JSTraceable, MallocSizeOf)]
+struct SavedNode {
+    node: Dom<Node>,
+    children: Vec<Dom<Node>>,
+    data: Option<DOMString>,
+}
+#[derive(Clone, JSTraceable, MallocSizeOf)]
+struct EditSnapshot {
+    host: Dom<HTMLElement>,
+    nodes: Vec<SavedNode>,
+    anchor: Dom<Node>,
+    anchor_offset: u32,
+    focus: Dom<Node>,
+    focus_offset: u32,
+    bytes: usize,
+}
+impl js::gc::Rootable for EditSnapshot {}
+#[derive(Clone, JSTraceable, MallocSizeOf)]
+struct EditEntry {
+    before: EditSnapshot,
+    after: EditSnapshot,
+}
+#[derive(Default, JSTraceable, MallocSizeOf)]
+struct EditHistory {
+    undo: Vec<EditEntry>,
+    redo: Vec<EditEntry>,
+    pending: Option<EditSnapshot>,
+}
+impl EditSnapshot {
+    fn capture(cx: &mut JSContext, document: &Document) -> Option<Self> {
+        let host = document.editable_selection_host(cx)?;
+        let selection = document.GetSelection(cx)?;
+        let anchor = selection.GetAnchorNode(cx)?;
+        let focus = selection.GetFocusNode(cx)?;
+        let mut nodes = Vec::new();
+        let mut stack = vec![DomRoot::from_ref(host.upcast::<Node>())];
+        let mut bytes = 0;
+        while let Some(node) = stack.pop() {
+            if nodes.len() >= 512 {
+                return None;
+            }
+            let children: Vec<_> = node.children().collect();
+            let data = node
+                .downcast::<CharacterData>()
+                .map(CharacterDataMethods::Data);
+            bytes += data
+                .as_ref()
+                .map_or(0, |data| data.len_utf16().0 as usize * 2)
+                + children.len() * std::mem::size_of::<Dom<Node>>();
+            if bytes > 256 * 1024 {
+                return None;
+            }
+            nodes.push(SavedNode {
+                node: Dom::from_ref(&node),
+                children: children.iter().map(|n| Dom::from_ref(&**n)).collect(),
+                data,
+            });
+            stack.extend(children.into_iter().rev());
+        }
+        Some(Self {
+            host: Dom::from_ref(&host),
+            nodes,
+            anchor: Dom::from_ref(&anchor),
+            anchor_offset: selection.AnchorOffset(cx),
+            focus: Dom::from_ref(&focus),
+            focus_offset: selection.FocusOffset(cx),
+            bytes,
+        })
+    }
+    fn same_dom(&self, other: &Self) -> bool {
+        self.host == other.host
+            && self.nodes.len() == other.nodes.len()
+            && self
+                .nodes
+                .iter()
+                .zip(&other.nodes)
+                .all(|(a, b)| a.node == b.node && a.children == b.children && a.data == b.data)
+    }
+    fn restore(&self, cx: &mut JSContext, document: &Document) -> bool {
+        // All handles are rooted through the snapshot for the complete restore.
+        for saved in &self.nodes {
+            let parent = DomRoot::from_ref(&*saved.node);
+            for (index, child) in saved.children.iter().enumerate() {
+                let current = parent.children().nth(index);
+                if current.as_deref() != Some(&**child)
+                    && parent.InsertBefore(cx, child, current.as_deref()).is_err()
+                {
+                    return false;
+                }
+            }
+            while parent.children().count() > saved.children.len() {
+                let Some(extra) = parent.children().nth(saved.children.len()) else {
+                    break;
+                };
+                if parent.RemoveChild(cx, &extra).is_err() {
+                    return false;
+                }
+            }
+            if let Some(data) = &saved.data
+                && let Some(character) = parent.downcast::<CharacterData>()
+                && character.Data() != *data
+            {
+                character.SetData(cx, data.clone());
+            }
+        }
+        document.GetSelection(cx).is_some_and(|selection| {
+            selection
+                .SetBaseAndExtent(
+                    cx,
+                    &self.anchor,
+                    self.anchor_offset,
+                    &self.focus,
+                    self.focus_offset,
+                )
+                .is_ok()
+        })
+    }
+}
+
+type Point = (DomRoot<Node>, u32);
+struct Span {
+    start: u32,
+    end: u32,
+    from: Point,
+    to: Point,
+    text: bool,
+}
+pub(crate) struct EditableText {
+    pub text: String,
+    spans: Vec<Span>,
+    boundaries: Vec<(Point, u32)>,
+    length: u32,
+}
+impl EditableText {
+    pub fn new(host: &HTMLElement) -> Self {
+        let mut map = Self {
+            text: String::new(),
+            spans: Vec::new(),
+            boundaries: Vec::new(),
+            length: 0,
+        };
+        map.walk(host.upcast(), true);
+        map
+    }
+    fn separator(&mut self, from: Point, to: Point) {
+        let start = self.length;
+        self.text.push('\n');
+        self.length += 1;
+        self.spans.push(Span {
+            start,
+            end: self.length,
+            from,
+            to,
+            text: false,
+        });
+    }
+    fn walk(&mut self, node: &Node, root: bool) {
+        if let Some(text) = node.downcast::<Text>() {
+            let data = text.upcast::<CharacterData>().Data();
+            let length = data.len_utf16().0;
+            let start = self.length;
+            self.text.push_str(&data.str());
+            self.length += length;
+            self.spans.push(Span {
+                start,
+                end: self.length,
+                from: (DomRoot::from_ref(node), 0),
+                to: (DomRoot::from_ref(node), length),
+                text: true,
+            });
+            return;
+        }
+        let children: Vec<_> = node.children().collect();
+        for (index, child) in children.iter().enumerate() {
+            self.boundaries
+                .push(((DomRoot::from_ref(node), index as u32), self.length));
+            let before = (DomRoot::from_ref(node), index as u32);
+            let after = (DomRoot::from_ref(node), index as u32 + 1);
+            let br = child
+                .downcast::<Element>()
+                .is_some_and(|e| e.local_name() == &local_name!("br"));
+            if br {
+                self.separator(before, after);
+                continue;
+            }
+            if !child.is_editable_or_editing_host() && child.is::<Element>() {
+                let start = self.length;
+                self.text.push('\u{fffc}');
+                self.length += 1;
+                self.spans.push(Span {
+                    start,
+                    end: self.length,
+                    from: before,
+                    to: after,
+                    text: false,
+                });
+                continue;
+            }
+            if child.is_block_node() && !self.text.is_empty() && !self.text.ends_with('\n') {
+                self.separator(before.clone(), (child.clone(), 0));
+            }
+            self.walk(child, false);
+            if child.is_block_node() && index + 1 < children.len() && !self.text.ends_with('\n') {
+                self.separator((child.clone(), child.len()), after);
+            }
+        }
+        self.boundaries.push((
+            (DomRoot::from_ref(node), children.len() as u32),
+            self.length,
+        ));
+        let _ = root;
+    }
+    pub fn offset(&self, node: &Node, offset: u32) -> Option<u32> {
+        for span in &self.spans {
+            if span.text && std::ptr::eq(&*span.from.0, node) && offset <= span.end - span.start {
+                return Some(span.start + offset);
+            }
+        }
+        self.boundaries
+            .iter()
+            .find(|((n, o), _)| std::ptr::eq(&**n, node) && *o == offset)
+            .map(|(_, value)| *value)
+    }
+    pub fn point(&self, offset: u32) -> Option<Point> {
+        let offset = offset.min(self.length);
+        for span in &self.spans {
+            if offset >= span.start && offset <= span.end {
+                return Some(if span.text {
+                    (span.from.0.clone(), offset - span.start)
+                } else if offset == span.start {
+                    span.from.clone()
+                } else {
+                    span.to.clone()
+                });
+            }
+        }
+        self.boundaries.last().map(|(point, _)| point.clone())
+    }
+    pub fn byte(&self, offset: u32) -> Option<usize> {
+        let mut units = 0;
+        for (byte, ch) in self.text.char_indices() {
+            if units == offset {
+                return Some(byte);
+            }
+            units += ch.len_utf16() as u32;
+            if units > offset {
+                return None;
+            }
+        }
+        (units == offset).then_some(self.text.len())
+    }
+    pub fn selection(&self, cx: &mut JSContext, selection: &Selection) -> Option<(u32, u32)> {
+        let anchor = selection.GetAnchorNode(cx)?;
+        let focus = selection.GetFocusNode(cx)?;
+        Some((
+            self.offset(&anchor, selection.AnchorOffset(cx))?,
+            self.offset(&focus, selection.FocusOffset(cx))?,
+        ))
+    }
+}
+// Composition replaces only its live range, without invoking the legacy
+// rich-text deletion command (which adds placeholder BRs on every update).
+pub(crate) fn insert_editable_text(
+    cx: &mut JSContext,
+    document: &Document,
+    selection: &Selection,
+    text: &str,
+) -> bool {
+    let Some(range) = selection.active_range(cx) else {
+        return false;
+    };
+    if range.DeleteContents(cx).is_err() || selection.CollapseToStart(cx).is_err() {
+        return false;
+    }
+    let Some(range) = selection.active_range(cx) else {
+        return false;
+    };
+    let node = range.start_container();
+    let offset = range.start_offset();
+    if text.is_empty() {
+        return true;
+    }
+    let value = DOMString::from(text);
+    let length = value.len_utf16().0;
+    if let Some(data) = node.downcast::<CharacterData>() {
+        if data.InsertData(cx, offset, value).is_err() {
+            return false;
+        }
+        selection.Collapse(cx, Some(&node), offset + length).is_ok()
+    } else {
+        let text = document.CreateTextNode(cx, value);
+        let node = text.upcast::<Node>();
+        if range.InsertNode(cx, node).is_err() {
+            return false;
+        }
+        selection.Collapse(cx, Some(node), length).is_ok()
+    }
+}
+impl Document {
+    // The legacy rich-text deletion algorithm creates a placeholder BR even
+    // for repeated in-text replacement. Keep same-node text deletion direct and
+    // use grapheme boundaries; retain its structural paragraph merging fallback.
+    pub(crate) fn delete_editable_text(
+        &self,
+        cx: &mut JSContext,
+        selection: &Selection,
+        backward: bool,
+    ) -> Option<bool> {
+        let range = selection.active_range(cx)?;
+        let node = range.start_container();
+        if node != range.end_container()
+            || !node.is::<Text>()
+            || !node.is_editable_or_editing_host()
+        {
+            return None;
+        }
+        if range.collapsed() {
+            let data = node.downcast::<CharacterData>()?.Data();
+            let rope = Rope::new(data.to_string());
+            let offset = range.start_offset();
+            let origin = rope.utf8_offset_to_rope_index(
+                rope.utf16_offset_to_utf8_offset(Utf16CodeUnits(offset)),
+            );
+            let next = rope
+                .index_to_utf16_offset(rope.move_by(
+                    origin,
+                    RopeMovement::Grapheme,
+                    if backward { -1 } else { 1 },
+                ))
+                .0;
+            if next == offset {
+                return None;
+            }
+            if selection
+                .SetBaseAndExtent(cx, &node, offset, &node, next)
+                .is_err()
+            {
+                return Some(false);
+            }
+        }
+        let range = selection.active_range(cx)?;
+        Some(range.DeleteContents(cx).is_ok() && selection.CollapseToStart(cx).is_ok())
+    }
+    pub(crate) fn begin_edit_history(&self, cx: &mut JSContext) {
+        let snapshot = EditSnapshot::capture(cx, self);
+        let mut history = self.native_editing().history.borrow_mut();
+        if snapshot.as_ref().is_none_or(|current| {
+            history
+                .undo
+                .last()
+                .is_some_and(|entry| !entry.after.same_dom(current))
+        }) {
+            history.undo.clear();
+            history.redo.clear();
+        }
+        history.pending = snapshot;
+    }
+    pub(crate) fn finish_edit_history(&self, cx: &mut JSContext) {
+        let after = EditSnapshot::capture(cx, self);
+        let mut history = self.native_editing().history.borrow_mut();
+        let Some(before) = history.pending.take() else {
+            return;
+        };
+        let Some(after) = after else {
+            history.undo.clear();
+            history.redo.clear();
+            return;
+        };
+        if before.host != after.host {
+            history.undo.clear();
+            history.redo.clear();
+            return;
+        }
+        if before.same_dom(&after) {
+            return;
+        }
+        history.redo.clear();
+        history.undo.push(EditEntry { before, after });
+        while history.undo.len() > 32
+            || history
+                .undo
+                .iter()
+                .map(|entry| entry.before.bytes + entry.after.bytes)
+                .sum::<usize>()
+                > 2 * 1024 * 1024
+        {
+            history.undo.remove(0);
+        }
+    }
+    pub(crate) fn native_edit_undo(&self, cx: &mut JSContext, redo: bool) -> bool {
+        let Some(current) = EditSnapshot::capture(cx, self) else {
+            return false;
+        };
+        rooted!(&in(cx) let current=current);
+        let entry = {
+            let history = self.native_editing().history.borrow();
+            if redo {
+                history.redo.last()
+            } else {
+                history.undo.last()
+            }
+            .cloned()
+        };
+        let Some(entry) = entry else {
+            return true;
+        };
+        let (expected, target) = if redo {
+            (entry.before, entry.after)
+        } else {
+            (entry.after, entry.before)
+        };
+        rooted!(&in(cx) let expected=expected);
+        rooted!(&in(cx) let target=target);
+        if !expected.same_dom(&current) {
+            let mut history = self.native_editing().history.borrow_mut();
+            history.undo.clear();
+            history.redo.clear();
+            return true;
+        }
+        let host = DomRoot::from_ref(&*target.host);
+        let kind = if redo { "historyRedo" } else { "historyUndo" };
+        if !self.fire_editable_input(cx, &host, kind, None, false, true) {
+            return true;
+        }
+        let Some(now) = EditSnapshot::capture(cx, self) else {
+            return true;
+        };
+        if !expected.same_dom(&now) {
+            return true;
+        }
+        if !target.restore(cx, self) {
+            return true;
+        }
+        {
+            let mut history = self.native_editing().history.borrow_mut();
+            if redo {
+                if let Some(entry) = history.redo.pop() {
+                    history.undo.push(entry);
+                }
+            } else if let Some(entry) = history.undo.pop() {
+                history.redo.push(entry);
+            }
+        }
+        self.fire_editable_input(cx, &host, kind, None, false, false);
+        self.publish_editable_context(cx, false);
+        true
+    }
+    pub(crate) fn editable_selection_host(
+        &self,
+        cx: &mut JSContext,
+    ) -> Option<DomRoot<HTMLElement>> {
+        let selection = self.GetSelection(cx)?;
+        let range = selection.active_range(cx)?;
+        let start = range.start_container();
+        let end = range.end_container();
+        if !start.is_editable_or_editing_host() || !end.is_editable_or_editing_host() {
+            return None;
+        }
+        let host = start.editing_host_of()?;
+        if end.editing_host_of().as_deref() != Some(&*host) {
+            return None;
+        }
+        if self
+            .focus_handler()
+            .focused_area()
+            .element()
+            .and_then(|element| element.upcast::<Node>().editing_host_of())
+            .as_deref()
+            != Some(&*host)
+        {
+            return None;
+        }
+        host.downcast::<HTMLElement>().map(DomRoot::from_ref)
+    }
+    pub(crate) fn move_editable_selection(
+        &self,
+        cx: &mut JSContext,
+        direction: EditingDirection,
+        motion: EditingMotion,
+        extend: ModifySelection,
+    ) -> bool {
+        let Some(host) = self.editable_selection_host(cx) else {
+            return false;
+        };
+        let Some(selection) = self.GetSelection(cx) else {
+            return false;
+        };
+        let map = EditableText::new(&host);
+        let Some((anchor, focus)) = map.selection(cx, &selection) else {
+            return false;
+        };
+        let rope = Rope::new(map.text.clone());
+        let forward = matches!(direction, EditingDirection::Forward);
+        let movement = match motion {
+            EditingMotion::Character => RopeMovement::Character,
+            EditingMotion::Grapheme => RopeMovement::Grapheme,
+            EditingMotion::Word => RopeMovement::Word,
+            EditingMotion::Line | EditingMotion::Page => RopeMovement::Line,
+            EditingMotion::LineStartOrEnd => RopeMovement::LineStartOrEnd,
+            EditingMotion::DocumentStartOrEnd => RopeMovement::RopeStartOrEnd,
+        };
+        let next;
+        if matches!(extend, ModifySelection::No)
+            && anchor != focus
+            && matches!(motion, EditingMotion::Grapheme | EditingMotion::Character)
+        {
+            next = if forward {
+                anchor.max(focus)
+            } else {
+                anchor.min(focus)
+            };
+        } else {
+            let origin = rope
+                .utf8_offset_to_rope_index(rope.utf16_offset_to_utf8_offset(Utf16CodeUnits(focus)));
+            let step = if matches!(motion, EditingMotion::Page) {
+                28
+            } else {
+                1
+            };
+            next = rope
+                .index_to_utf16_offset(rope.move_by(
+                    origin,
+                    movement,
+                    if forward { step } else { -step },
+                ))
+                .0;
+        }
+        let Some((focus_node, focus_offset)) = map.point(next) else {
+            return false;
+        };
+        let (anchor_node, anchor_offset) = if matches!(extend, ModifySelection::Yes) {
+            match map.point(anchor) {
+                Some(p) => p,
+                None => return false,
+            }
+        } else {
+            (focus_node.clone(), focus_offset)
+        };
+        let _ =
+            selection.SetBaseAndExtent(cx, &anchor_node, anchor_offset, &focus_node, focus_offset);
+        self.publish_editable_context(cx, false);
+        true
+    }
+    pub(crate) fn fire_editable_input(
+        &self,
+        cx: &mut JSContext,
+        host: &HTMLElement,
+        kind: &str,
+        data: Option<&str>,
+        composing: bool,
+        before: bool,
+    ) -> bool {
+        let window = self.window();
+        let event = InputEvent::new(
+            cx,
+            window,
+            None,
+            if before {
+                atom!("beforeinput")
+            } else {
+                atom!("input")
+            },
+            true,
+            before && !composing,
+            Some(window),
+            0,
+            data.map(DOMString::from),
+            composing,
+            DOMString::from(kind),
+        );
+        let event = event.upcast::<Event>();
+        event.set_composed(true);
+        event.fire(cx, host.upcast())
+    }
+    pub(crate) fn editable_surrounding(
+        &self,
+        cx: &mut JSContext,
+        host: &HTMLElement,
+    ) -> Option<ImeSurroundingText> {
+        let map = EditableText::new(host);
+        let selection = self.GetSelection(cx)?;
+        let (anchor, cursor) = map.selection(cx, &selection)?;
+        let (mut anchor, mut cursor) = (map.byte(anchor)?, map.byte(cursor)?);
+        let mut text = map.text.clone();
+        if self.native_editing().composition_host.get().as_deref() == Some(host)
+            && let Some(range) = self.native_editing().composition_range.get()
+        {
+            let start = map.byte(map.offset(&range.start_container(), range.start_offset())?)?;
+            let end = map.byte(map.offset(&range.end_container(), range.end_offset())?)?;
+            text.replace_range(start..end, "");
+            let adjust = |offset: usize| {
+                if offset > end {
+                    offset - (end - start)
+                } else if offset >= start {
+                    start
+                } else {
+                    offset
+                }
+            };
+            anchor = adjust(anchor);
+            cursor = adjust(cursor);
+        }
+        ImeSurroundingText::new(&text, cursor, anchor)
+    }
+    pub(crate) fn publish_editable_context(&self, cx: &mut JSContext, input_method: bool) {
+        let Some(host) = self.editable_selection_host(cx) else {
+            return;
+        };
+        if !self.embedder_controls().has_ime_for(host.upcast()) {
+            self.show_editable_ime(cx, &host);
+            return;
+        }
+        self.embedder_controls().update_ime_context(
+            host.upcast(),
+            self.editable_surrounding(cx, &host),
+            input_method,
+        );
+    }
+    pub(crate) fn show_editable_ime(&self, cx: &mut JSContext, host: &HTMLElement) {
+        if self.editable_selection_host(cx).as_deref() != Some(host) {
+            return;
+        }
+        let text = EditableText::new(host);
+        let selection = self.GetSelection(cx);
+        let cursor = selection
+            .and_then(|s| text.selection(cx, &s))
+            .map(|(_, c)| c);
+        self.embedder_controls().show_embedder_control(
+            crate::dom::document_embedder_controls::ControlElement::Ime(
+                script_bindings::root::Dom::from_ref(host),
+            ),
+            embedder_traits::EmbedderControlRequest::InputMethod(
+                embedder_traits::InputMethodRequest {
+                    input_method_type: embedder_traits::InputMethodType::Text,
+                    text: text.text,
+                    insertion_point: cursor,
+                    surrounding: self.editable_surrounding(cx, host),
+                    multiline: true,
+                    allow_virtual_keyboard: self.window().has_sticky_activation(),
+                },
+            ),
+            None,
+        );
+    }
+    pub(crate) fn delete_editable_surrounding(
+        &self,
+        cx: &mut JSContext,
+        expected: &ImeSurroundingText,
+        before: u32,
+        after: u32,
+        replacement: Option<&str>,
+    ) -> bool {
+        let Some(host) = self.editable_selection_host(cx) else {
+            return false;
+        };
+        if self.native_editing().composition_range.get().is_some()
+            || self.editable_surrounding(cx, &host).as_ref() != Some(expected)
+        {
+            return false;
+        }
+        let map = EditableText::new(&host);
+        let Some(selection) = self.GetSelection(cx) else {
+            return false;
+        };
+        let Some((anchor, cursor)) = map.selection(cx, &selection) else {
+            return false;
+        };
+        let (Some(start), Some(end)) = (map.byte(anchor.min(cursor)), map.byte(anchor.max(cursor)))
+        else {
+            return false;
+        };
+        let (before, after) = (before as usize, after as usize);
+        if before > expected.cursor.min(expected.anchor)
+            || after > expected.text.len() - expected.cursor.max(expected.anchor)
+            || before > start
+            || end + after > map.text.len()
+        {
+            return false;
+        }
+        let (from, to) = (start - before, end + after);
+        if !map.text.is_char_boundary(from) || !map.text.is_char_boundary(to) {
+            return false;
+        }
+        if !self.fire_editable_input(cx, &host, "deleteContentBackward", None, false, true) {
+            return false;
+        }
+        if self.editable_selection_host(cx).as_deref() != Some(&*host)
+            || self.editable_surrounding(cx, &host).as_ref() != Some(expected)
+        {
+            return false;
+        }
+        self.begin_edit_history(cx);
+        let offset = |byte: usize| map.text[..byte].encode_utf16().count() as u32;
+        let range_for = |cx: &mut JSContext, start: usize, end: usize| {
+            let (a, ao) = map.point(offset(start))?;
+            let (b, bo) = map.point(offset(end))?;
+            Some(Range::new(cx, self, &a, ao, &b, bo))
+        };
+        if let Some(text) = replacement {
+            let Some(range) = range_for(cx, from, to) else {
+                return false;
+            };
+            selection.RemoveAllRanges(cx.no_gc());
+            selection.AddRange(cx.no_gc(), &range);
+            if !insert_editable_text(cx, self, &selection, text) {
+                return false;
+            }
+        } else {
+            let Some(left) = range_for(cx, from, start) else {
+                return false;
+            };
+            let Some(right) = range_for(cx, end, to) else {
+                return false;
+            };
+            if right.DeleteContents(cx).is_err() || left.DeleteContents(cx).is_err() {
+                return false;
+            }
+        }
+        self.finish_edit_history(cx);
+        if let Some(text) = replacement {
+            let event = crate::dom::types::CompositionEvent::new(
+                cx,
+                self.window(),
+                atom!("compositionend").into(),
+                true,
+                false,
+                Some(self.window()),
+                0,
+                DOMString::from(text),
+            );
+            event.upcast::<Event>().fire(cx, host.upcast());
+        }
+        self.fire_editable_input(
+            cx,
+            &host,
+            if replacement.is_some() {
+                "insertCompositionText"
+            } else {
+                "deleteContentBackward"
+            },
+            replacement,
+            false,
+            false,
+        );
+        self.publish_editable_context(cx, true);
+        true
+    }
+    pub(crate) fn editable_composition(
+        &self,
+        cx: &mut JSContext,
+        state: keyboard_types::CompositionState,
+        text: &str,
+    ) {
+        use keyboard_types::CompositionState::{End, Start, Update};
+        let Some(host) = self.editable_selection_host(cx) else {
+            return;
+        };
+        if matches!(state, End) && self.native_editing().composition_host.get().is_none() {
+            self.begin_edit_history(cx);
+        }
+        if matches!(state, Start) {
+            self.begin_edit_history(cx);
+            self.native_editing().composition_host.set(Some(&host));
+            self.native_editing().composition_range.set(None);
+            return;
+        }
+        if self
+            .native_editing()
+            .composition_host
+            .get()
+            .as_deref()
+            .is_some_and(|original| original != &*host)
+        {
+            return;
+        }
+        let Some(selection) = self.GetSelection(cx) else {
+            return;
+        };
+        if let Some(range) = self.native_editing().composition_range.get() {
+            selection.RemoveAllRanges(cx.no_gc());
+            selection.AddRange(cx.no_gc(), &range);
+        }
+        if !self.fire_editable_input(
+            cx,
+            &host,
+            "insertCompositionText",
+            Some(text),
+            matches!(state, Update),
+            true,
+        ) {
+            return;
+        }
+        if self.editable_selection_host(cx).as_deref() != Some(&*host) {
+            return;
+        }
+        let Some(before) = selection.active_range(cx) else {
+            return;
+        };
+        let start = before.CloneRange(cx);
+        start.Collapse(cx.no_gc(), true);
+        if !insert_editable_text(cx, self, &selection, text) {
+            return;
+        }
+        let Some(after) = selection.active_range(cx) else {
+            return;
+        };
+        let preedit = Range::new(
+            cx,
+            self,
+            &start.start_container(),
+            start.start_offset(),
+            &after.end_container(),
+            after.end_offset(),
+        );
+        if matches!(state, End) {
+            self.native_editing().composition_host.set(None);
+            self.native_editing().composition_range.set(None);
+        } else {
+            self.native_editing().composition_host.set(Some(&host));
+            self.native_editing().composition_range.set(Some(&preedit));
+        }
+        if matches!(state, End) {
+            self.finish_edit_history(cx);
+        }
+        self.fire_editable_input(
+            cx,
+            &host,
+            "insertCompositionText",
+            Some(text),
+            matches!(state, Update),
+            false,
+        );
+        self.publish_editable_context(cx, true);
+    }
+}
