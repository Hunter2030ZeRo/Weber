+/// A bounded UTF-8 view around the caret, excluding preedit. Offsets are bytes.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+pub struct ImeSurroundingText {
+    pub text: String,
+    pub cursor: usize,
+    pub anchor: usize,
+}
+impl ImeSurroundingText {
+    /// Keep the complete selection and as much adjacent context as fits in tiv3.
+    pub fn new(text: &str, cursor: usize, anchor: usize) -> Option<Self> {
+        if !text.is_char_boundary(cursor) || !text.is_char_boundary(anchor) || text.contains('\0') { return None; }
+        let left = cursor.min(anchor);
+        let right = cursor.max(anchor);
+        if right - left > 4000 { return None; }
+        let spare = 4000 - (right - left);
+        let mut start = left.saturating_sub(spare / 2);
+        while !text.is_char_boundary(start) { start += 1; }
+        let mut end = (start + 4000).min(text.len());
+        while !text.is_char_boundary(end) { end -= 1; }
+        if end < right { return None; }
+        // Fill unused space at the left when the suffix is shorter.
+        start = end.saturating_sub(4000).min(start);
+        while !text.is_char_boundary(start) { start += 1; }
+        Some(Self { text: text[start..end].to_owned(), cursor: cursor-start, anchor: anchor-start })
+    }
+}
