+#[cfg(test)]
+mod weber_lifetime_tests {
+    use super::*;
+    use paint_api::PaintMessage;
+    use std::sync::{
+        Arc,
+        atomic::{AtomicU32, Ordering},
+    };
+
+    #[test]
+    fn retired_requests_do_not_resurrect_keys_or_damage_another_painter() {
+        let requests = Arc::new(AtomicU32::new(0));
+        let observed = requests.clone();
+        let api = CrossProcessPaintApi::dummy_with_callback(Some(Box::new(move |message| {
+            if let PaintMessage::GenerateFontKeys(fonts, instances, sender, painter) = message {
+                observed.fetch_add(1, Ordering::Relaxed);
+                let _ = sender.send((
+                    (1..=fonts)
+                        .map(|n| FontKey::new(painter.into(), n as u32))
+                        .collect(),
+                    (1..=instances)
+                        .map(|n| FontInstanceKey::new(painter.into(), n as u32))
+                        .collect(),
+                ));
+            } else {
+                panic!("Retired requests must not reach Paint");
+            }
+        })));
+        let (sender, port) = generic_channel::channel().unwrap();
+        let proxy = SystemFontServiceProxySender(sender).to_proxy();
+        let retired = PainterId::next();
+        let kept = PainterId::next();
+        let worker = thread::spawn(move || {
+            let mut service = SystemFontService {
+                port,
+                local_families: Default::default(),
+                paint_api: api,
+                painter_fonts: HashMap::new(),
+                generic_fonts: Default::default(),
+            };
+            service.run();
+            service.painter_fonts
+        });
+        proxy.prefetch_font_keys_for_painter(retired);
+        proxy.prefetch_font_keys_for_painter(kept);
+        assert_ne!(
+            proxy.generate_font_key(retired),
+            FontKey::new(retired.into(), 0)
+        );
+        assert_ne!(
+            proxy.generate_font_instance_key(retired),
+            FontInstanceKey::new(retired.into(), 0)
+        );
+        proxy.remove_painter(retired);
+        for _ in 0..64 {
+            assert_eq!(
+                proxy.generate_font_key(retired),
+                FontKey::new(retired.into(), 0)
+            );
+            assert_eq!(
+                proxy.generate_font_instance_key(retired),
+                FontInstanceKey::new(retired.into(), 0)
+            );
+            assert_eq!(
+                proxy.get_system_font_instance(
+                    FontIdentifier::ArrayBuffer(uuid::Uuid::nil()),
+                    Au::from_px(16),
+                    FontInstanceFlags::empty(),
+                    Default::default(),
+                    vec![],
+                    retired,
+                ),
+                FontInstanceKey::new(retired.into(), 0)
+            );
+        }
+        assert_ne!(proxy.generate_font_key(kept), FontKey::new(kept.into(), 0));
+        assert_ne!(
+            proxy.generate_font_instance_key(kept),
+            FontInstanceKey::new(kept.into(), 0)
+        );
+        proxy.exit();
+        let caches = worker.join().unwrap();
+        assert_eq!(caches.len(), 1);
+        assert!(caches.contains_key(&kept));
+        assert_eq!(requests.load(Ordering::Relaxed), 2);
+    }
+}
